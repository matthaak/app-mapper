{
  "name": "app-mapper",
  "productName": "App Mapper",
  "private": true,
  "version": "0.1.0",
  "description": "Maps an application’s architecture from its Markdown files.",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "app": "npm run build:electron && node scripts/dev-app.mjs",
    "md": "npm run build:electron && node scripts/dev-app.mjs --md",
    "start": "npm run build && electron .",
    "start:md": "npm run build && electron dist-electron/md-main.js",
    "build": "tsc && vite build && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:md": "npm run build && electron-builder --config electron-builder.md-editor.json",
    "dist:md:mac": "npm run build && electron-builder --mac --config electron-builder.md-editor.json",
    "dist:md:win": "npm run build && electron-builder --win --config electron-builder.md-editor.json"
  },
  "build": {
    "appId": "app.mapper.desktop",
    "productName": "App Mapper",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    }
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
